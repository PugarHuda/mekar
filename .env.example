# ─────────────────────────────────────────────────────────────────
# 0G Galileo Testnet (DEFAULT for development)
# ─────────────────────────────────────────────────────────────────
ZG_GALILEO_RPC=https://evmrpc-testnet.0g.ai
ZG_GALILEO_CHAIN_ID=16602
ZG_GALILEO_EXPLORER=https://chainscan-galileo.0g.ai
ZG_GALILEO_STORAGE_EXPLORER=https://storagescan-galileo.0g.ai
ZG_GALILEO_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZG_GALILEO_FAUCET=https://faucet.0g.ai

# Galileo system contracts
ZG_GALILEO_FLOW_CONTRACT=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296
ZG_GALILEO_MINE_CONTRACT=0x00A9E9604b0538e06b268Fb297Df333337f9593b
ZG_GALILEO_REWARD_CONTRACT=0xA97B57b4BdFEA2D0a25e535bd849ad4e6C440A69

# ─────────────────────────────────────────────────────────────────
# 0G Aristotle Mainnet (for production)
# ─────────────────────────────────────────────────────────────────
ZG_MAINNET_RPC=https://evmrpc.0g.ai
ZG_MAINNET_CHAIN_ID=16661
ZG_MAINNET_EXPLORER=https://chainscan.0g.ai
ZG_MAINNET_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai

# Mainnet system contracts
ZG_MAINNET_FLOW_CONTRACT=0x62D4144dB0F0a6fBBaeb6296c785C71B3D57C526
ZG_MAINNET_MINE_CONTRACT=0xCd01c5Cd953971CE4C2c9bFb95610236a7F414fe
ZG_MAINNET_REWARD_CONTRACT=0x457aC76B58ffcDc118AABD6DbC63ff9072880870

# ─────────────────────────────────────────────────────────────────
# Deployer wallet (DO NOT COMMIT REAL KEY)
# ─────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_NETWORK=galileo
NEXT_PUBLIC_CHAIN_ID=16602
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_EXPLORER_URL=https://chainscan-galileo.0g.ai
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses (filled after deployment — see scripts/deploy-v2-fix.sh)
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_AGENT_INFT_ADDRESS=
NEXT_PUBLIC_ROYALTY_VAULT_ADDRESS=
NEXT_PUBLIC_TRAINING_DATA_REGISTRY_ADDRESS=
NEXT_PUBLIC_ALIGNMENT_AUDITOR_ADDRESS=

# Block height at which the active RoyaltyVault was deployed. Used as the
# lower bound for log-scan queries (useUserStats, useAgentInferenceHistory).
# Bump this when redeploying the vault — without it, the hook scans from
# an older anchor and re-fetches every historical event on each cold load.
#   Galileo testnet v2:  32160000
#   Aristotle mainnet:   set to the block of your mainnet vault deploy tx
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=32160000

# ─────────────────────────────────────────────────────────────────
# 0G Compute Broker (TEE inference)
# ─────────────────────────────────────────────────────────────────
ZG_COMPUTE_BROKER_URL=

# ─────────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
BACKEND_CORS_ORIGIN=http://localhost:3000

# Frontend → backend bridge for 0G Storage uploads (used by /mint)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
